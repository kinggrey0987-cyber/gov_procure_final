{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "tsc && vite build",
        "dev": "vite",
        "pack": "powershell -ExecutionPolicy Bypass -File ./package_update.ps1",
        "package": "powershell -ExecutionPolicy Bypass -File ./package_update.ps1",
        "test:playwright": "playwright test",
        "test:playwright:ui": "playwright test --ui",
        "test:cypress": "cypress run --browser chrome",
        "test:cypress:open": "cypress open",
        "test:selenium": "python tests/selenium/test_portal.py",
        "test:api": "python -m coverage run -m pytest tests/api && python -m coverage report -m",
        "test:backend": "php artisan test",
        "test:phpstan": "vendor/bin/phpstan analyse --memory-limit=2G",
        "test:all": "powershell -ExecutionPolicy Bypass -File ./run_all_tests.ps1"
    },
    "devDependencies": {
        "@headlessui/react": "^2.0.0",
        "@inertiajs/react": "^2.0.0",
        "@playwright/test": "^1.63.0",
        "@tailwindcss/forms": "^0.5.3",
        "@types/node": "^20.19.0",
        "@types/react": "^18.0.28",
        "@types/react-dom": "^18.0.10",
        "@vitejs/plugin-react": "^4.2.0",
        "autoprefixer": "^10.4.12",
        "axios": "^1.11.0",
        "concurrently": "^9.0.1",
        "cypress": "^16.0.0",
        "laravel-vite-plugin": "^2.0.0",
        "postcss": "^8.4.31",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "tailwindcss": "^3.2.1",
        "typescript": "^5.0.2",
        "vite": "^7.1.0"
    },
    "dependencies": {
        "html2canvas": "^1.4.1",
        "jspdf": "^4.2.1"
    }
}
