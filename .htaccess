<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^$ public/ [L]
    RewriteRule (.*) public/$1 [L]
</IfModule>

# Block direct access to sensitive files, dotfiles, and scripts
<FilesMatch "^\.(env|git|svn|hg)|(composer|package)\.(json|lock)$|artisan|\.(ps1|sh|bat)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

DirectoryIndex index.php public/index.php
